<?xml version="1.0" encoding="utf-8"?>
<!-- "Morning Paper", small (about 2x2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextClock
        android:id="@+id/today_date"
        style="@style/WidgetText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM" />

    <TextClock
        android:id="@+id/today_time"
        style="@style/WidgetText.Clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textSize="38sp" />

    <LinearLayout
        android:id="@+id/weather_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weather_temp"
            style="@style/WidgetText.Temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_weather_partly_cloudy_day"
            android:gravity="center_vertical"
            android:text="@string/preview_temperature"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/weather_line"
            style="@style/WidgetText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preview_condition"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
