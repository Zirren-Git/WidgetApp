<?xml version="1.0" encoding="utf-8"?>
<!-- "Morning Paper", medium (about 4x2). Texts below are only for the widget picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/today_date"
            style="@style/WidgetText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/today_time"
                style="@style/WidgetText.Clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm" />

            <LinearLayout
                android:id="@+id/weather_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_weather_partly_cloudy_day" />

                    <TextView
                        android:id="@+id/weather_temp"
                        style="@style/WidgetText.Temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/preview_temperature" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weather_line"
                    style="@style/WidgetText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxWidth="170dp"
                    android:text="@string/preview_weather_line" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/today_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_hairline" />

        <LinearLayout
            android:id="@+id/next_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/next_event_bar"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_event_bar"
                android:tint="@color/tessera_accent" />

            <TextView
                android:id="@+id/next_event_when"
                style="@style/WidgetText.When"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/preview_event_when" />

            <TextView
                android:id="@+id/next_event_title"
                style="@style/WidgetText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/preview_event_title" />

            <TextView
                android:id="@+id/next_event_hint"
                style="@style/WidgetText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/today_status"
            style="@style/WidgetText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
